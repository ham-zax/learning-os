{
  "name": "generic-tutor",
  "version": "0.1.0",
  "type": "module",
  "description": "AI tutor engine with spaced repetition, interview prep, and ecosystem integration",
  "bin": {
    "tutor": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "node --max-old-space-size=4096 node_modules/.bin/tsc --noEmit --incremental",
    "tutor": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["tutor", "spaced-repetition", "sm2", "interview-prep", "learning"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ding/generic-tutor.git"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "ora": "^8.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
